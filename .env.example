# Copy this file to .env and fill in your own values. Never commit .env.

# --- Claude (form filling + job scoring) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Notion tracker ---
# Create an internal integration at https://www.notion.so/profile/integrations,
# then share the Job Applications database with it (... > Connections).
NOTION_TOKEN=
# The 32-character ID in the database URL (before ?v=).
NOTION_DB_ID=
# "notion" or "local". Leave empty to pick notion when the two values above are set,
# otherwise a local JSON file (data/applications.json).
TRACKER_BACKEND=
# Name of the URL property in your database that holds the job posting link.
NOTION_URL_PROPERTY=Job Posting URL

# --- Your resume ---
# Plain-text resume used to fill forms and score fit. Add an "Application answers"
# section for things a resume does not say (work authorization, salary, start date).
RESUME_PATH=resume.txt
# Optional PDF/DOCX to attach when a form has a resume upload field.
RESUME_FILE=

# --- Browser ---
# msedge or chrome uses the browser already installed. Empty = Playwright's own
# Chromium (run: python -m playwright install chromium).
BROWSER_CHANNEL=msedge
# Or the full path to any Chromium-based browser (overrides BROWSER_CHANNEL), e.g. Comet:
# BROWSER_PATH=C:/Users/DELL/AppData/Local/Perplexity/Comet/Application/comet.exe
BROWSER_PATH=
# Folder where the app's browser keeps cookies and logins between runs. Sign in once with
# "python -m jobhunt login". Empty = a clean temporary profile every run. Do not point this at
# your everyday browser profile: Chromium refuses automation on its default profile folder.
BROWSER_PROFILE_DIR=

# --- Email monitoring (IMAP) ---
# For Gmail/Outlook use an app password, not your account password.
IMAP_HOST=
EMAIL_ADDRESS=
EMAIL_PASSWORD=
IMAP_FOLDER=INBOX

# --- Notifications (both optional) ---
# Slack / Discord / any endpoint that accepts a JSON POST.
NOTIFY_WEBHOOK_URL=
# Email alerts, sent with the EMAIL_ADDRESS / EMAIL_PASSWORD above.
SMTP_HOST=
SMTP_PORT=587
NOTIFY_EMAIL_TO=

FOLLOW_UP_DAYS=7
